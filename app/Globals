@tailwind base;
@tailwind components;
@tailwind utilities;

html {
  scroll-behavior: smooth;
}

body {
  background-color: #fbf8f2;
  overflow-x: hidden;
}

::selection {
  background-color: #1f9e8e;
  color: #ffffff;
}

.checkerboard {
  background-image:
    linear-gradient(45deg, #eee9dd 25%, transparent 25%),
    linear-gradient(-45deg, #eee9dd 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #eee9dd 75%),
    linear-gradient(-45deg, transparent 75%, #eee9dd 75%);
  background-size: 20px 20px;
  background-position: 0 0, 0 10px, 10px -10px, -10px 0px;
  background-color: #f7f2e7;
}

/* Animated blob background */
.blob-field {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}
.blob {
  position: absolute;
  border-radius: 9999px;
  filter: blur(60px);
  opacity: 0.35;
}
.blob-1 {
  width: 420px;
  height: 420px;
  background: #1f9e8e;
  top: -120px;
  left: -100px;
  animation: float1 16s ease-in-out infinite;
}
.blob-2 {
  width: 360px;
  height: 360px;
  background: #f4794e;
  top: 60px;
  right: -140px;
  animation: float2 20s ease-in-out infinite;
}
.blob-3 {
  width: 300px;
  height: 300px;
  background: #e8a93c;
  bottom: -140px;
  left: 30%;
  animation: float3 18s ease-in-out infinite;
}

@keyframes float1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(40px, 50px) scale(1.1); }
}
@keyframes float2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-50px, 30px) scale(1.15); }
}
@keyframes float3 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(30px, -40px) scale(1.05); }
}

@keyframes fade-up {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
.fade-up {
  animation: fade-up 0.5s ease-out;
}

@keyframes bounce-soft {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}
.bounce-soft {
  animation: bounce-soft 2.4s ease-in-out infinite;
}

@keyframes spin-slow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.spin-slow {
  animation: spin-slow 2.5s linear infinite;
}

@keyframes progress-indeterminate {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(250%); }
}
.progress-bar-fill {
  animation: progress-indeterminate 1.4s ease-in-out infinite;
}

@keyframes pop-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}
.pop-in {
  animation: pop-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes pulse-ring {
  0% { box-shadow: 0 0 0 0 rgba(31, 158, 142, 0.35); }
  70% { box-shadow: 0 0 0 14px rgba(31, 158, 142, 0); }
  100% { box-shadow: 0 0 0 0 rgba(31, 158, 142, 0); }
}
.pulse-ring {
  animation: pulse-ring 2s ease-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  .blob-1, .blob-2, .blob-3, .bounce-soft, .spin-slow,
  .progress-bar-fill, .fade-up, .pop-in, .pulse-ring {
    animation: none;
  }
}
